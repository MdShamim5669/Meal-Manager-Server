model Member {
  id                  String    @id @default(uuid())
  name                String
  email               String?   @unique
  phone               String?   @unique
  pinHash             String
  role                Role      @default(MEMBER)
  active              Boolean   @default(true)
  joinedDate          DateTime  @default(now())
  resetToken          String?
  resetTokenExpiresAt DateTime?

  meals      MealEntry[]
  expenses   Expense[]
  deposits   Deposit[]
  dutyRoster DutyRoster[]
}
