        {
          "name": "Setup Initial Manager",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 201) {",
                  "    var res = pm.response.json();",
                  "    if (res.data && res.data.token) {",
                  "        pm.environment.set('authToken', res.data.token);",
                  "    }",
                  "    if (res.data && res.data.member && res.data.member.id) {",
                  "        pm.environment.set('memberId', res.data.member.id);",
                  "    }",
                  "}"
